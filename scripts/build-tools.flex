h_add(names,"test-ui-desktop");
let i=0;while i<h_count(names){let name=h_at(names,i);h_compile(compiler,h_cat3("scripts/",name,".flex"),h_join(out,name));i=i+1;}h_print(1,h_cat(h_int(h_count(names))," Collie tools built\n"));return 0;}
