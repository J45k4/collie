h_add(names,"test-collie-document-provider-android");
h_add(names,"test-collie-documents-android");
h_add(names,"test-collie-gatt-android");
h_add(names,"test-collie-gatt-server-android");
h_add(names,"test-collie-haptics-android");
h_add(names,"test-collie-hardware-access-android");
