import "../.flexscript/scripts/lib/build.flex";
fn main(argc,argv){h_environment(argc,argv);let compiler=h_real(b_option(argc,argv,"--compiler","build/compiler"));let out=b_option(argc,argv,"--out","build/tools");h_mkdir(out);let names=h_vec();
h_add(names,"build-collie");
